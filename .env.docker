# Configurações para rodar a aplicação com Docker Compose.
# Copie este arquivo para .env com o comando: cp .env.docker .env

# Variáveis para a conexão do Rails
DB_ADAPTER=postgresql
DB_USERNAME=postgres
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432
RAILS_MAX_THREADS=5

# URL do Redis
REDIS_URL=redis://redis:6379/0