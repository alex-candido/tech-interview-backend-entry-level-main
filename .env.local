# Configurações para rodar a aplicação localmente com ./bin/dev
# Copie este arquivo para .env com o comando: cp .env.local .env

# Variáveis para a conexão do Rails
DB_ADAPTER=postgresql
DB_USERNAME=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
RAILS_MAX_THREADS=5

# URL do Redis
REDIS_URL=redis://localhost:6379/0
